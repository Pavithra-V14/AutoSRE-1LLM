
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_OUTPUT_TOKENS=4096

LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
LLM_QUOTA_COOLDOWN_SECONDS=3600
LLM_OVERSIZED_COOLDOWN_SECONDS=86400

PLAN_HISTORY_KEEP_RECENT=4

AGENT_FAST_PATH=true

GEMINI_API_KEY=
OPENROUTER_API_KEY=
SUPABASE_URL=
# Backend only: the SERVICE_ROLE key (never the anon key -- that one is public in the dashboard)
SUPABASE_KEY=
SUPABASE_TIMEOUT_SECONDS=10

SLACK_WEBHOOK_URL=
ESCALATION_THRESHOLD_MINUTES=15

DASHBOARD_ORIGIN=http://localhost:3000
CONTROL_API_KEY=
# Simulator
SIMULATOR_BASE_URL=http://localhost:8100
OPENROUTER_MODEL=openrouter/free
SIMULATOR_TOKEN_SECRET=dev-only-insecure-secret-change-me

MAX_LLM_CALLS_PER_INCIDENT=8
MAX_COST_PER_INCIDENT_USD=1.00
MAX_LATENCY_MS_PER_INCIDENT=60000
AGENT_FAST_PATH_MAX_STEPS=10

OTEL_SDK_DISABLED=true
LLM_MAX_COOLDOWN_SECONDS=86400
LATENCY_P99_ALERT_THRESHOLD_MS=30000
LATENCY_ALERT_COOLDOWN_MINUTES=60

# Structured-output reliability: total attempts per JSON-producing LLM call
# (1 = no re-ask). A malformed answer is re-asked once with the exact error.
LLM_JSON_MAX_ATTEMPTS=2

# Stop investigating after this many consecutive duplicate/invalid planner turns
MAX_CONSECUTIVE_NO_PROGRESS=2

# Confidence below this routes the incident to a human (needs_approval)
LOW_CONFIDENCE_THRESHOLD=0.6
# Ceiling on confidence when a REQUIRED tool (deploy history / metrics) was unavailable
REQUIRED_DEGRADED_MAX_CONFIDENCE=0.5

# Benchmark judge: grade with a different provider than the agent's (groq | gemini | openrouter).
# Leave empty to use the normal provider order.
JUDGE_PROVIDER=

# Sampling temperature for investigation calls (0 = repeatable). Judge has its own.
LLM_TEMPERATURE=0.0
JUDGE_TEMPERATURE=0.0

# Default number of times tools/run_benchmark.py runs each scenario (--runs overrides)
BENCHMARK_RUNS=1

# Refuse to start (instead of warning) when SUPABASE_KEY is not a service_role key
SUPABASE_REQUIRE_SERVICE_ROLE=false

# Tracing: off | console | otlp   (OTEL_EXPORTER_OTLP_ENDPOINT etc. apply for otlp)
AUTOSRE_TRACING=off

# LLM provider order, e.g. "groq,gemini" to leave out OpenRouter's free routed models
LLM_PROVIDER_ORDER=groq,gemini,openrouter
# Schema-constrained decoding on Groq (falls back to plain JSON mode if rejected)
LLM_STRUCTURED_OUTPUT=true
# Optional provider routing: cheap model plans, stronger one synthesizes and is the escalation target
PLANNER_PROVIDER=
SYNTHESIS_PROVIDER=
SYNTHESIS_ESCALATION_PROVIDER=
# Hard cap on tool calls per incident
MAX_TOOL_CALLS_PER_INCIDENT=8
# Override the service dependency catalog
TOPOLOGY_PATH=
# Record/replay LLM calls: off | record | replay (see README)
LLM_REPLAY_MODE=off
LLM_REPLAY_DIR=tests/fixtures/llm_replay
